PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=

# Deployed frontend origin (example: https://your-frontend.vercel.app)
FRONTEND_URL=https://my-novamart-website.vercel.app

# Optional comma-separated whitelist for CORS
# Example: https://your-frontend.vercel.app,http://localhost:3000
CORS_ORIGINS=https://my-novamart-website.vercel.app,http://localhost:3000

# Optional: allow any https://*.vercel.app preview deployment origin
ALLOW_VERCEL_PREVIEW_ORIGINS=false

# Optional backend base URL. Used only if GOOGLE_CALLBACK_URL is not set.
# Example: https://your-backend.onrender.com
BACKEND_URL=

# Google OAuth Web Client credentials
GOOGLE_CLIENT_ID=387620556759-tue0vudt5hbtfgbum62cs96ck1b1qtrb.apps.googleusercontent.com

# Optional: needed only for redirect/callback OAuth flow (/api/auth/google + /google/callback).
# Not required when frontend sends Google ID token to POST /api/auth/google.
GOOGLE_CLIENT_SECRET=

# Exact backend callback URL registered in Google Cloud Console
# Example: https://your-backend.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
